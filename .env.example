# ==============================================================================
# Telegram NotebookLM 播客与信息图生成机器人 - 环境变量配置模板
# 复制本文件为 .env 并按需填写配置：cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot 基础配置
# ------------------------------------------------------------------------------
# Telegram 机器人 Token（由 @BotFather 提供）
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 授权访问的单个 Telegram 用户 ID（整数数字，可通过 @userinfobot 获取）
# 机器人具备严格单用户白名单防护，非白名单请求直接静默丢弃，请勿留空
ALLOWED_USER_ID=123456789

# ------------------------------------------------------------------------------
# 2. Antigravity CLI 与推理模型配置
# ------------------------------------------------------------------------------
# Antigravity CLI 可执行文件名或绝对路径（支持 PATH 中的 antigravity 或 agy）
ANTIGRAVITY_BIN="antigravity"

# Antigravity 调度的推理模型名称（建议使用支持工具调用的高速/高性能模型）
ANTIGRAVITY_MODEL="gemini-3.8-flash-medium"

# 全局任务超时阈值（单位：秒，默认 1800 秒 / 30 分钟）
# 双生成物（中文音频 + 知识信息图）在长文本下云端合成耗时约 8~18 分钟，建议预留 1800s 充裕窗口
TASK_TIMEOUT_SECONDS=1800

# ------------------------------------------------------------------------------
# 3. 多模态 Vision 图像提取配置 (可选)
# ------------------------------------------------------------------------------
# 可选：配置 Gemini API Key 直接调用官方多模态 REST API 提取图片文字。
# 若留空不填，系统将自动使用已认证的 Antigravity CLI (agy / antigravity) 免 Key 调度多模态视觉模型进行提取。
# GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 4. 网络代理配置 (可选)
# ------------------------------------------------------------------------------
# 若服务器或本地开发环境处于国内网络，访问 Telegram API 与 Google NotebookLM 建议开启代理
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"
